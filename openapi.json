{
  "openapi": "3.1.0",
  "info": {
    "title": "MDM Doctor transient API",
    "description": "No-auth, no-persistence API for the active transient analysis only.",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    },
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/job": {
      "post": {
        "summary": "Stream an archive and create a transient job",
        "parameters": [
          {
            "in": "header",
            "name": "X-MDM-Source-Name",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Upload accepted; the 256-bit handle is returned only in X-MDM-Job-Handle"
          }
        }
      },
      "get": {
        "summary": "Get active job state",
        "responses": {
          "200": {
            "description": "Current state"
          }
        }
      },
      "delete": {
        "summary": "Immediately purge the active job",
        "responses": {
          "204": {
            "description": "Purged or already absent"
          }
        }
      }
    },
    "/api/v1/job/cancel": {
      "post": {
        "summary": "Cancel and purge analysis",
        "responses": {
          "204": {
            "description": "Cancelled"
          }
        }
      }
    },
    "/api/v1/job/reanalyze": {
      "post": {
        "summary": "Reanalyze while the transient upload exists",
        "responses": {
          "202": {
            "description": "Queued"
          }
        }
      }
    },
    "/api/v1/job/summary": {
      "get": {
        "summary": "Evidence-based summary",
        "responses": {
          "200": {
            "description": "Summary"
          }
        }
      }
    },
    "/api/v1/job/sessions": {
      "get": {
        "summary": "Sessions",
        "responses": {
          "200": {
            "description": "Sessions"
          }
        }
      }
    },
    "/api/v1/job/findings": {
      "get": {
        "summary": "Evidence-linked findings",
        "responses": {
          "200": {
            "description": "Findings"
          }
        }
      }
    },
    "/api/v1/job/applications": {
      "get": {
        "summary": "Applications",
        "responses": {
          "200": {
            "description": "Applications"
          }
        }
      }
    },
    "/api/v1/job/attempts": {
      "get": {
        "summary": "Execution attempts",
        "responses": {
          "200": {
            "description": "Attempts"
          }
        }
      }
    },
    "/api/v1/job/entities": {
      "get": {
        "summary": "Managed entities",
        "responses": {
          "200": {
            "description": "Entities"
          }
        }
      }
    },
    "/api/v1/job/esp": {
      "get": {
        "summary": "ESP resources",
        "responses": {
          "200": {
            "description": "ESP state"
          }
        }
      }
    },
    "/api/v1/job/provisioning": {
      "get": {
        "summary": "Provisioning steps",
        "responses": {
          "200": {
            "description": "Steps"
          }
        }
      }
    },
    "/api/v1/job/coverage": {
      "get": {
        "summary": "Parser and collection coverage",
        "responses": {
          "200": {
            "description": "Coverage records"
          }
        }
      }
    },
    "/api/v1/job/warnings": {
      "get": {
        "summary": "Sanitized parser warnings",
        "responses": {
          "200": {
            "description": "Warnings"
          }
        }
      }
    },
    "/api/v1/job/artifacts": {
      "get": {
        "summary": "Active artifact tree",
        "responses": {
          "200": {
            "description": "Artifacts"
          }
        }
      }
    },
    "/api/v1/job/query/timeline": {
      "post": {
        "summary": "Body-based bounded timeline query",
        "responses": {
          "200": {
            "description": "Timeline page"
          }
        }
      }
    },
    "/api/v1/job/evidence/resolve": {
      "post": {
        "summary": "Resolve active evidence identifiers from a request body",
        "responses": {
          "200": {
            "description": "Evidence links"
          }
        }
      }
    },
    "/api/v1/job/artifact/preview": {
      "post": {
        "summary": "Return an inert bounded text preview",
        "responses": {
          "200": {
            "description": "Safe preview"
          }
        }
      }
    },
    "/api/v1/job/artifact/download": {
      "post": {
        "summary": "Stream an active transient artifact",
        "responses": {
          "200": {
            "description": "Artifact stream"
          }
        }
      }
    },
    "/api/v1/job/export": {
      "post": {
        "summary": "Stream an on-demand report",
        "responses": {
          "200": {
            "description": "HTML, CSV, JSON, or PDF"
          }
        }
      }
    },
    "/api/v1/compare/summary": {
      "post": {
        "summary": "Compare two active jobs using two capability headers",
        "responses": {
          "200": {
            "description": "Transient comparison"
          }
        }
      }
    },
    "/api/v1/health/live": {
      "get": {
        "summary": "Liveness",
        "responses": {
          "200": {
            "description": "Alive"
          }
        }
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "summary": "Readiness",
        "responses": {
          "200": {
            "description": "Ready"
          }
        }
      }
    },
    "/api/v1/limits": {
      "get": {
        "summary": "Sanitized configured limits",
        "responses": {
          "200": {
            "description": "Limits"
          }
        }
      }
    },
    "/api/v1/build": {
      "get": {
        "summary": "Sanitized build metadata",
        "responses": {
          "200": {
            "description": "Build metadata"
          }
        }
      }
    },
    "/api/v1/openapi.json": {
      "get": {
        "summary": "OpenAPI 3.1 document",
        "responses": {
          "200": {
            "description": "OpenAPI document"
          }
        }
      }
    }
  },
  "components": {
