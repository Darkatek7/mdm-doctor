# Host interface published by Docker Compose. Keep loopback unless the host is
# on a trusted internal network or VPN.
BIND_ADDRESS=127.0.0.1
PORT=8080
# MDM_DOCTOR_IMAGE=ghcr.io/darkatek7/mdm-doctor:latest

JOB_TTL_SECONDS=1800
MAX_UPLOAD_BYTES=1073741824
MAX_EXPANDED_BYTES=4294967296
MAX_FILE_BYTES=1073741824
MAX_ARCHIVE_FILES=100000
MAX_NESTING_DEPTH=4
MAX_COMPRESSION_RATIO=100
MAX_AGGREGATE_RATIO=50
MAX_EVENTS=1250000
MAX_ACTIVE_JOBS=4
MAX_CONCURRENT_UPLOADS=2
MAX_WORKERS=2
JOB_TIMEOUT_SECONDS=1200
PARSER_TIMEOUT_SECONDS=120
TIMELINE_PAGE_SIZE=100
TIMELINE_PAGE_MAX=500
DEBUG_SANITIZED=false
